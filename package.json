{
  "name": "the-hollow",
  "version": "0.0.0",
  "private": true,
  "description": "An AI agent that sets up a complete, secure CI/CD pipeline for your project on GitHub Actions.",
  "license": "Apache-2.0",
  "author": "PatchFarm",
  "homepage": "https://github.com/PatchFarm/the-hollow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PatchFarm/the-hollow.git"
  },
  "bugs": {
    "url": "https://github.com/PatchFarm/the-hollow/issues"
  },
  "keywords": [
    "ci",
    "cd",
    "github-actions",
    "devops",
    "pipeline",
    "ai-agent",
    "cli"
  ],
  "type": "module",
  "bin": {
    "hollow": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "schema": "npm run build && node scripts/gen-schema.mjs"
  },
  "dependencies": {
    "smol-toml": "1.9.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
