{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1,
      "description": "Schema version. Always 1 for now."
    },
    "project": {
      "default": {},
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "enum": [
            "node",
            "python"
          ]
        },
        "packageManager": {
          "type": "string",
          "enum": [
            "npm",
            "pnpm",
            "yarn",
            "bun",
            "pip",
            "uv",
            "poetry"
          ]
        },
        "runtimeVersion": {
          "description": "Node or Python version, for example `22` or `3.13`.",
          "type": "string",
          "minLength": 1
        },
        "defaultBranch": {
          "description": "Branch that CI runs on after merges. Defaults to `main`.",
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "commands": {
          "type": "object",
          "properties": {
            "install": {
              "description": "Installs dependencies from the lockfile.",
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "lint": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                {
                  "type": "boolean",
                  "const": false
                }
              ]
            },
            "format": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                {
                  "type": "boolean",
                  "const": false
                }
              ]
            },
            "typecheck": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                {
                  "type": "boolean",
                  "const": false
                }
              ]
            },
            "test": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "build": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                {
                  "type": "boolean",
                  "const": false
                }
              ]
            }
          },
          "additionalProperties": false,
          "description": "Commands CI runs instead of the detected ones. `false` drops a check; tests cannot be dropped."
        }
      },
      "additionalProperties": false,
      "description": "Overrides for what The Hollow detects. Leave empty to use detection."
    },
    "environments": {
      "default": {
        "staging": {},
        "preprod": {
          "enabled": false
        },
        "production": {
          "approvers": [],
          "preventSelfReview": false
        }
      },
      "type": "object",
      "properties": {
        "staging": {
          "default": {},
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "description": "Public https URL used for health checks and smoke tests."
            }
          },
          "additionalProperties": false
        },
        "preprod": {
          "default": {
            "enabled": false
          },
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "description": "Preprod is opt-in.",
              "type": "boolean"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "description": "Public https URL used for health checks and smoke tests."
            }
          },
          "additionalProperties": false
        },
        "production": {
          "default": {
            "approvers": [],
            "preventSelfReview": false
          },
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "description": "Public https URL used for health checks and smoke tests."
            },
            "approvers": {
              "default": [],
              "description": "Who can approve production deploys (up to 6 users or org/team). Empty means whoever runs `hollow protect`.",
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^@?[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})(?:\\/[A-Za-z0-9._-]+)?$",
                "description": "GitHub user (`octocat`) or team (`org/team`)."
              }
            },
            "preventSelfReview": {
              "default": false,
              "description": "Stop people from approving deploys they started. Leave off when one person both deploys and approves.",
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "Staging and production always exist. Production is always behind an approval gate, which cannot be turned off."
    },
    "deploy": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "target": {
              "type": "string",
              "const": "vercel"
            },
            "tokenSecret": {
              "default": "VERCEL_TOKEN",
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "description": "Name of a GitHub Actions secret. Never put secret values in hollow.yml."
            },
            "orgIdVariable": {
              "default": "VERCEL_ORG_ID",
              "description": "GitHub Actions variable holding the Vercel team (org) ID.",
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "projectIdVariable": {
              "default": "VERCEL_PROJECT_ID",
              "description": "GitHub Actions variable holding the Vercel project ID.",
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "bypassSecret": {
              "default": "VERCEL_AUTOMATION_BYPASS_SECRET",
              "description": "Optional secret with Vercel's Protection Bypass for Automation value, so health checks can reach protected deployment URLs.",
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          },
          "required": [
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "target": {
              "type": "string",
              "const": "cloudflare-workers"
            },
            "tokenSecret": {
              "default": "CLOUDFLARE_API_TOKEN",
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "description": "Name of a GitHub Actions secret. Never put secret values in hollow.yml."
            },
            "accountIdVariable": {
              "default": "CLOUDFLARE_ACCOUNT_ID",
              "description": "GitHub Actions variable holding the Cloudflare account ID.",
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          },
          "required": [
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "target": {
              "type": "string",
              "const": "cloudflare-pages"
            },
            "tokenSecret": {
              "default": "CLOUDFLARE_API_TOKEN",
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "description": "Name of a GitHub Actions secret. Never put secret values in hollow.yml."
            },
            "accountIdVariable": {
              "default": "CLOUDFLARE_ACCOUNT_ID",
              "description": "GitHub Actions variable holding the Cloudflare account ID.",
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "projectName": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "required": [
            "target",
            "projectName"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "target": {
              "type": "string",
              "const": "docker"
            },
            "registry": {
              "default": "ghcr.io",
              "type": "string",
              "const": "ghcr.io"
            },
            "image": {
              "description": "Image name in the registry. Defaults to the GitHub repo name.",
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$"
            },
            "appPort": {
              "description": "Port the app listens on inside its container. Defaults to 3000 for Node and 8000 for Python.",
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "required": [
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "target": {
              "type": "string",
              "const": "vps"
            },
            "host": {
              "type": "string",
              "pattern": "^[A-Za-z0-9.-]+$",
              "description": "Server hostname or IP. Its SSH host key is pinned in known_hosts."
            },
            "user": {
              "default": "deploy",
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_-]*$"
            },
            "port": {
              "default": 22,
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "path": {
              "default": "/srv/app",
              "type": "string",
              "pattern": "^\\/[A-Za-z0-9._/-]*$"
            },
            "sshKeySecret": {
              "default": "VPS_SSH_KEY",
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "description": "Name of a GitHub Actions secret. Never put secret values in hollow.yml."
            },
            "knownHostsVariable": {
              "default": "VPS_KNOWN_HOSTS",
              "description": "GitHub Actions variable holding the server's SSH host key line (from `ssh-keyscan`), so deploys only talk to that server.",
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "image": {
              "description": "Image name in the registry. Defaults to the GitHub repo name.",
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$"
            },
            "appPort": {
              "description": "Port the app listens on inside its container. Defaults to 3000 for Node and 8000 for Python.",
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "required": [
            "target",
            "host"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Where the app is deployed."
    },
    "release": {
      "default": {
        "tokenSecret": "RELEASE_PLEASE_TOKEN"
      },
      "type": "object",
      "properties": {
        "tokenSecret": {
          "default": "RELEASE_PLEASE_TOKEN",
          "description": "Secret with a token release-please uses, so its release pull requests run CI. Falls back to the workflow's own token when the secret is not set.",
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "outputDir": {
          "description": "Build output folder to attach to each release for targets without a container image. Detected for Vite, Astro, Next.js, Nuxt and Cloudflare Pages.",
          "type": "string",
          "pattern": "^[A-Za-z0-9._][A-Za-z0-9._/-]*$"
        }
      },
      "additionalProperties": false,
      "description": "How releases are versioned and what each release carries."
    },
    "protection": {
      "default": {
        "requiredApprovals": 0
      },
      "type": "object",
      "properties": {
        "requiredApprovals": {
          "default": 0,
          "description": "Approvals a pull request needs before it can merge. 0 suits a solo project, since GitHub does not let you approve your own pull request.",
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        }
      },
      "additionalProperties": false,
      "description": "Branch rules that `hollow protect` applies to the default branch."
    },
    "verify": {
      "default": {
        "healthPath": "/",
        "syntheticEvery": "15m"
      },
      "type": "object",
      "properties": {
        "healthPath": {
          "default": "/",
          "description": "Path checked after every deploy, on each environment's url. A failed check rolls the deploy back.",
          "type": "string",
          "pattern": "^\\/[A-Za-z0-9._~/?=&%-]*$"
        },
        "syntheticEvery": {
          "default": "15m",
          "description": "How often scheduled.yml checks each environment's url plus healthPath. GitHub runs schedules at best every 5 minutes and often late, so this is a baseline, not uptime monitoring.",
          "type": "string",
          "enum": [
            "off",
            "5m",
            "15m",
            "30m",
            "1h"
          ]
        }
      },
      "additionalProperties": false,
      "description": "How each deploy is checked."
    },
    "security": {
      "default": {
        "failOn": "high",
        "sast": "auto",
        "nightlyScan": true
      },
      "type": "object",
      "properties": {
        "failOn": {
          "default": "high",
          "description": "Lowest severity that fails the pipeline. Lower findings are reported only.",
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "sast": {
          "default": "auto",
          "description": "`auto` uses CodeQL on public repos and Semgrep on private ones.",
          "type": "string",
          "enum": [
            "auto",
            "codeql",
            "semgrep"
          ]
        },
        "nightlyScan": {
          "default": true,
          "description": "Re-scan the default branch's dependencies every night, since new vulnerabilities are published without any code changing.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "database": {
      "default": {
        "migrations": "auto",
        "destructiveChangeLabel": "allow-destructive-migration",
        "urlSecret": "DATABASE_URL"
      },
      "type": "object",
      "properties": {
        "migrations": {
          "default": "auto",
          "type": "string",
          "enum": [
            "auto",
            "none",
            "prisma",
            "drizzle",
            "alembic",
            "django"
          ]
        },
        "destructiveChangeLabel": {
          "default": "allow-destructive-migration",
          "description": "PR label required to merge a migration that drops or renames data.",
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "urlSecret": {
          "default": "DATABASE_URL",
          "description": "Environment secret with each environment's database URL, used to migrate it before a deploy. On the VPS target, migrations read DATABASE_URL from the server's .env instead.",
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      },
      "additionalProperties": false
    },
    "notifications": {
      "default": {
        "incidentIssues": true
      },
      "type": "object",
      "properties": {
        "slackWebhookSecret": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "description": "Name of a GitHub Actions secret. Never put secret values in hollow.yml."
        },
        "discordWebhookSecret": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "description": "Name of a GitHub Actions secret. Never put secret values in hollow.yml."
        },
        "incidentIssues": {
          "default": true,
          "description": "Open an issue when a production deploy fails.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "agent": {
      "default": {
        "ai": true,
        "apiKeyEnv": "HOLLOW_AI_API_KEY",
        "maxRepairAttempts": 3,
        "maxSpendUsd": 2,
        "maxTokens": 300000
      },
      "type": "object",
      "properties": {
        "ai": {
          "default": true,
          "description": "Set to false for the same result as --no-ai.",
          "type": "boolean"
        },
        "provider": {
          "description": "How to talk to your model: the OpenAI-compatible Chat Completions API (most hosted providers and local servers) or Anthropic's Messages API. No model is used until this and model are set.",
          "type": "string",
          "enum": [
            "openai-compatible",
            "anthropic"
          ]
        },
        "model": {
          "description": "Model name, as your provider spells it.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "description": "The API base URL, for example https://api.openai.com/v1 or http://localhost:11434/v1."
        },
        "apiKeyEnv": {
          "default": "HOLLOW_AI_API_KEY",
          "description": "Environment variable holding the API key. The key never goes in hollow.yml.",
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "maxRepairAttempts": {
          "default": 3,
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "maxSpendUsd": {
          "default": 2,
          "description": "Hard cap on model spend per run, in US dollars. Needs pricing.",
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "pricing": {
          "description": "Your model's price per million tokens, so the spend cap can count dollars. Without it, maxTokens caps each run instead.",
          "type": "object",
          "properties": {
            "inputPerMillionUsd": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            },
            "outputPerMillionUsd": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            }
          },
          "required": [
            "inputPerMillionUsd",
            "outputPerMillionUsd"
          ],
          "additionalProperties": false
        },
        "maxTokens": {
          "default": 300000,
          "description": "Token budget per run when pricing is not set (input plus output).",
          "type": "integer",
          "minimum": 1000,
          "maximum": 10000000
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "deploy"
  ],
  "additionalProperties": false,
  "title": "hollow.yml",
  "description": "Configuration for The Hollow. https://github.com/PatchFarm/the-hollow"
}
